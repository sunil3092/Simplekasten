// VaultVista — MVP schema.
// Scoped to the Must-Have loop from IMPLEMENTATION_PLAN.md §2: accounts, knowledge
// bases, notes, links, tags. Deferred for a later pass: OAuthAccount, RefreshToken,
// Subscription, KnowledgeBaseMember, NoteRevision, Attachment, ReviewQueue — none of
// them block getting notes + links + the desktop shell working end to end.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NoteType {
  fleeting
  literature
  permanent
  structure
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  knowledgeBases KnowledgeBase[]
  notes          Note[]

  @@map("users")
}

model KnowledgeBase {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes Note[]
  tags  Tag[]

  @@unique([ownerId, slug])
  @@map("knowledge_bases")
}

model Note {
  id          String   @id @default(cuid())
  kbId        String
  knowledgeBase KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  zettelId    String
  title       String
  content     String
  type        NoteType @default(fleeting)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  tags        NoteTag[]
  outboundLinks Link[] @relation("SourceNote")
  inboundLinks  Link[] @relation("TargetNote")

  @@unique([kbId, zettelId])
  @@index([kbId])
  @@map("notes")
}

// A Link can exist before its target note does — writing [[Atomicity]] before that
// note exists is normal Zettelkasten practice. targetTitle + resolved let the
// backlinks panel show it as a "linked mention" immediately either way.
model Link {
  id           String   @id @default(cuid())
  sourceNoteId String
  sourceNote   Note     @relation("SourceNote", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  targetNoteId String?
  targetNote   Note?    @relation("TargetNote", fields: [targetNoteId], references: [id], onDelete: Cascade)
  targetTitle  String
  context      String?
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([sourceNoteId])
  @@index([targetNoteId])
  @@map("links")
}

model Tag {
  id     String @id @default(cuid())
  kbId   String
  knowledgeBase KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  name   String

  notes NoteTag[]

  @@unique([kbId, name])
  @@map("tags")
}

model NoteTag {
  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@map("note_tags")
}
