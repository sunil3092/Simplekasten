// Simplekasten — MVP schema.
// Scoped to the Must-Have loop from IMPLEMENTATION_PLAN.md §2: accounts, knowledge
// bases, notes, links, tags, and session refresh (needed the moment a 15-minute
// access token can otherwise strand a user mid-session). Still deferred: OAuthAccount,
// Subscription, KnowledgeBaseMember, NoteRevision, ReviewQueue — none of
// them block getting notes + links + the desktop shell working end to end.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NoteType {
  fleeting
  literature
  permanent
  structure
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  knowledgeBases KnowledgeBase[]
  notes          Note[]
  refreshTokens  RefreshToken[]

  @@map("users")
}

// One row per device/session. Login (and refresh, which rotates the token)
// creates one of these; the raw token is only ever returned to the client —
// only its hash is stored, so a leaked database dump can't be used to log in.
model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  deviceLabel String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model KnowledgeBase {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes Note[]
  tags  Tag[]

  @@unique([ownerId, slug])
  @@map("knowledge_bases")
}

model Note {
  id          String   @id @default(cuid())
  kbId        String
  knowledgeBase KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  zettelId    String
  title       String
  content     String
  type        NoteType @default(fleeting)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Generated column (title weighted above content) + GIN index — both
  // hand-written in this field's migration, since Prisma can't express a
  // STORED GENERATED ALWAYS AS expression. Never read or written through
  // Prisma Client; only used via $queryRaw in note.search. Its presence
  // forces every other Note query below onto an explicit `select`, because
  // Prisma Client cannot represent an Unsupported type in a default result.
  searchVector Unsupported("tsvector")?

  tags        NoteTag[]
  outboundLinks Link[] @relation("SourceNote")
  inboundLinks  Link[] @relation("TargetNote")
  attachments   Attachment[]

  @@unique([kbId, zettelId])
  @@index([kbId])
  @@map("notes")
}

enum AttachmentKind {
  photo
  voice
}

// The file itself lives on local disk under apps/api's uploads directory
// (see export.ts's sibling attachments.ts), not S3/R2 as the plan calls for
// long-term — an MVP stand-in, same spirit as using Postgres tsvector instead
// of a dedicated search service. Swapping in real object storage later only
// touches attachments.ts; this row shape (id, mimeType, size) doesn't change.
model Attachment {
  id        String         @id @default(cuid())
  noteId    String
  note      Note           @relation(fields: [noteId], references: [id], onDelete: Cascade)
  kind      AttachmentKind
  filename  String
  mimeType  String
  size      Int
  createdAt DateTime       @default(now())

  @@index([noteId])
  @@map("attachments")
}

// A Link can exist before its target note does — writing [[Atomicity]] before that
// note exists is normal Zettelkasten practice. targetTitle + resolved let the
// backlinks panel show it as a "linked mention" immediately either way.
model Link {
  id           String   @id @default(cuid())
  sourceNoteId String
  sourceNote   Note     @relation("SourceNote", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  targetNoteId String?
  targetNote   Note?    @relation("TargetNote", fields: [targetNoteId], references: [id], onDelete: Cascade)
  targetTitle  String
  context      String?
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([sourceNoteId])
  @@index([targetNoteId])
  @@map("links")
}

model Tag {
  id     String @id @default(cuid())
  kbId   String
  knowledgeBase KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  name   String

  notes NoteTag[]

  @@unique([kbId, name])
  @@map("tags")
}

model NoteTag {
  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@map("note_tags")
}
