{
  "name": "@simplekasten/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "seed:dev": "node scripts/seed-dev-vault.js",
    "dev": "npm run seed:dev && concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "next dev",
    "dev:electron": "wait-on http://localhost:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 electron .",
    "build:renderer": "next build",
    "build:main": "esbuild main.js --bundle --platform=node --target=node20 --format=cjs --external:electron --define:process.env.SK_BUNDLED=\"1\" --outfile=main.bundle.js",
    "build": "npm run build:renderer && npm run build:main && electron-builder",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "demo": "playwright test -c playwright.demo.config.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.4",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "codemirror": "^6.0.1",
    "next": "^15.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-force-graph-2d": "^1.29.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@simplekasten/core": "*",
    "@simplekasten/local-engine": "*",
    "@simplekasten/themes": "*",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.9.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.simplekasten.app",
    "productName": "Simplekasten",
    "files": [
      "main.bundle.js",
      "preload.js",
      "icons/**/*",
      "out/**/*",
      "!node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "main.bundle.js"
    },
    "afterPack": "./scripts/adhoc-sign.js",
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "icons/icon.icns"
    },
    "win": {
      "icon": "icons/icon.ico"
    },
    "linux": {
      "icon": "icons/icon.png"
    }
  }
}
