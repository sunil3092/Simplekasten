{
  "name": "simplekasten",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @simplekasten/api",
    "dev:desktop": "npm run dev -w @simplekasten/desktop",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @simplekasten/api",
    "test:e2e": "npm run test -w @simplekasten/e2e",
    "db:generate": "npm run generate -w @simplekasten/db",
    "db:migrate": "npm run migrate -w @simplekasten/db"
  }
}
