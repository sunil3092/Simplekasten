{
  "name": "simplekasten",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @simplekasten/api",
    "dev:desktop": "npm run dev -w @simplekasten/desktop",
    "dev:mobile": "npm run start -w @simplekasten/mobile",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @simplekasten/api",
    "db:generate": "npm run generate -w @simplekasten/db",
    "db:migrate": "npm run migrate -w @simplekasten/db"
  }
}
